# Theme ported from iTerm2 profile (Sundried-style palette)

# Font
font-family = IBM Plex Mono
font-size = 13

# Base colors
background = #1e1e1e
foreground = #e6d4a3
cursor-color = #e6d4a3
cursor-text = #1e1e1e
selection-background = #e6d4a3
selection-foreground = #534a42

# ANSI palette
palette = 0=#1e1e1e
palette = 1=#be0f17
palette = 2=#868715
palette = 3=#cc881a
palette = 4=#377375
palette = 5=#a04b73
palette = 6=#578e57
palette = 7=#978771
palette = 8=#7f7061
palette = 9=#f73028
palette = 10=#aab01e
palette = 11=#f7b125
palette = 12=#719586
palette = 13=#c77089
palette = 14=#7db669
palette = 15=#e6d4a3

# Bright bold text, like iTerm "Use Bright Bold"
bold-is-bright = true

# iTerm profile had background blur enabled (no transparency)
background-blur = 20
