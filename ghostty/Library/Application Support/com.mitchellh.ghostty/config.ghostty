# Theme ported from iTerm2 profile (Sundried-style palette)

# Font
font-family = IBM Plex Mono
font-size = 13

# Base colors
background = #1e1e1e
foreground = #e6d4a3
cursor-color = #e6d4a3
cursor-text = #1e1e1e
cursor-style = block
cursor-style-blink = false
selection-background = #e6d4a3
selection-foreground = #534a42

# ANSI palette
palette = 0=#1e1e1e
palette = 1=#be0f17
palette = 2=#868715
palette = 3=#cc881a
palette = 4=#377375
palette = 5=#a04b73
palette = 6=#578e57
palette = 7=#978771
palette = 8=#7f7061
palette = 9=#f73028
palette = 10=#aab01e
palette = 11=#f7b125
palette = 12=#719586
palette = 13=#c77089
palette = 14=#7db669
palette = 15=#e6d4a3

# Bright bold text, like iTerm "Use Bright Bold"
# (bold-is-bright is deprecated since 1.2.0; bold-color = bright is the replacement)
bold-color = bright

# iTerm profile had background blur enabled
# blur is only visible with background-opacity < 1
background-opacity = 0.95
background-blur = 20

# Automatically copy on select
# On macOS, `true` copies to Ghostty's internal selection pasteboard, not the
# system clipboard — use `clipboard` to always write to the system clipboard.
# Known issue: on macOS 26 (Tahoe) some users report even `clipboard` only
# writes the private pasteboard (ghostty-org/ghostty discussion #5994, issue #12668).
# Verify with: select text in Ghostty, then run `pbpaste` in another app.
copy-on-select = clipboard
